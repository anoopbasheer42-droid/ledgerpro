<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard · LedgerPro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ============================================================
   LEDGERPRO — DASHBOARD (self-contained)
   ============================================================ */

:root{
  --bg: #f4f6f9;
  --surface: #ffffff;
  --subtle: #f8fafc;
  --hover: #f1f5f9;
  --border: #e2e8f0;
  --border-2: #cbd5e1;
  --text-1: #0f172a;
  --text-2: #334155;
  --text-3: #64748b;
  --text-4: #94a3b8;
  --primary: #1e40af;
  --primary-2: #2563eb;
  --primary-soft: #eff6ff;
  --success: #16a34a;
  --success-soft: #f0fdf4;
  --danger: #dc2626;
  --danger-soft: #fef2f2;
  --warning: #d97706;
  --warning-soft: #fffbeb;
  --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --mono: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
}

*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  font-family: var(--font);
  font-size: 14px;
  line-height: 1.5;
  color: var(--text-1);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
button{font-family:inherit;font-size:inherit;cursor:pointer}
a{text-decoration:none;color:inherit}
input{font-family:inherit}

/* ============================================================
   APP SHELL
   ============================================================ */
.app{
  display: grid;
  grid-template-columns: 240px 1fr;
  min-height: 100vh;
}

/* ============================================================
   SIDEBAR
   ============================================================ */
.sidebar{
  background: var(--surface);
  border-right: 1px solid var(--border);
  padding: 16px 0;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
}

.sb-brand{
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 20px 18px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 12px;
}
.sb-brand-mark{
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--primary), var(--primary-2));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 15px;
  flex-shrink: 0;
}
.sb-brand-name{font-weight: 800; font-size: 15px; letter-spacing: -0.2px}

.sb-nav{flex:1; padding: 0 8px}

.sb-section{
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.3px;
  color: var(--text-4);
  text-transform: uppercase;
  padding: 14px 12px 6px;
}

.sb-link{
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  border-radius: 8px;
  color: var(--text-2);
  font-size: 13px;
  font-weight: 500;
  margin-bottom: 1px;
  transition: all .12s ease;
}
.sb-link:hover{background: var(--hover); color: var(--text-1)}
.sb-link.active{
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}
.sb-link .icon{
  width: 16px;
  height: 16px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex-shrink: 0;
}

/* ============================================================
   MAIN AREA
   ============================================================ */
.main{
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* Topbar */
.topbar{
  height: 60px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  position: sticky;
  top: 0;
  z-index: 10;
  gap: 16px;
}

.tb-left{display:flex; align-items:center; gap:14px; min-width:0}

.tb-menu{
  display: none;
  background: none;
  border: none;
  padding: 8px;
  color: var(--text-2);
}
.tb-menu svg{width:20px; height:20px; stroke:currentColor; fill:none; stroke-width:2; stroke-linecap:round}

.tb-company{
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}
.tb-avatar{
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--primary), var(--primary-2));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 13px;
  flex-shrink: 0;
}
.tb-info{min-width:0}
.tb-name{font-size: 14px; font-weight: 700; color: var(--text-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 260px}
.tb-meta{font-size: 11px; color: var(--text-3); margin-top: 1px}

.tb-right{display:flex; align-items:center; gap:12px}

.tb-date{
  font-size: 12px;
  color: var(--text-3);
  padding: 6px 12px;
  background: var(--subtle);
  border-radius: 6px;
  border: 1px solid var(--border);
  font-family: var(--mono);
}

.tb-switch{
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 7px 12px;
  background: var(--surface);
  border: 1px solid var(--border-2);
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-2);
  transition: all .12s ease;
}
.tb-switch:hover{background: var(--hover); color: var(--text-1)}
.tb-switch svg{width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round}

/* Page */
.page{
  flex: 1;
  padding: 28px 28px 48px;
  max-width: 1440px;
  width: 100%;
  margin: 0 auto;
}

.page-header{margin-bottom: 24px}
.page-title{font-size: 24px; font-weight: 800; letter-spacing: -0.4px; color: var(--text-1)}
.page-sub{font-size: 14px; color: var(--text-3); margin-top: 4px}

/* ============================================================
   KPI CARDS
   ============================================================ */
.kpi-grid{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.kpi{
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px 20px;
  cursor: pointer;
  transition: all .15s ease;
  position: relative;
  overflow: hidden;
}
.kpi:hover{
  border-color: var(--border-2);
  box-shadow: 0 4px 16px rgba(15,23,42,0.06);
  transform: translateY(-1px);
}
.kpi-top{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.kpi-label{
  font-size: 11px;
  font-weight: 700;
  color: var(--text-3);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.kpi-icon{
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.kpi-icon svg{
  width: 16px;
  height: 16px;
  stroke-width: 2;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.kpi-icon.blue   { background: #dbeafe; }
.kpi-icon.blue svg{ stroke: #1e40af; }
.kpi-icon.red    { background: #fee2e2; }
.kpi-icon.red svg{ stroke: #b91c1c; }
.kpi-icon.green  { background: #dcfce7; }
.kpi-icon.green svg{ stroke: #15803d; }
.kpi-icon.amber  { background: #fef3c7; }
.kpi-icon.amber svg{ stroke: #b45309; }
.kpi-icon.purple { background: #e9d5ff; }
.kpi-icon.purple svg{ stroke: #6b21a8; }
.kpi-icon.teal   { background: #ccfbf1; }
.kpi-icon.teal svg{ stroke: #0f766e; }

.kpi-value{
  font-family: var(--mono);
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.5px;
  color: var(--text-1);
  line-height: 1.1;
}
.kpi-value.positive{ color: var(--success); }
.kpi-value.negative{ color: var(--danger); }

.kpi-meta{
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  color: var(--text-3);
  margin-top: 8px;
}
.kpi-meta .dot{
  width: 4px; height: 4px;
  background: var(--text-4);
  border-radius: 50%;
}

/* ============================================================
   CHART ROW
   ============================================================ */
.chart-row{
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 16px;
  margin-bottom: 24px;
}

.chart-card{
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
}
.chart-head{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 12px;
}
.chart-title{font-size: 14px; font-weight: 700; color: var(--text-1)}
.chart-sub{font-size: 12px; color: var(--text-3); margin-top: 2px}

.chart-empty{
  height: 200px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: var(--text-4);
  font-size: 13px;
  background: var(--subtle);
  border-radius: 8px;
  border: 1px dashed var(--border-2);
}
.chart-empty svg{
  width: 32px;
  height: 32px;
  stroke: var(--text-4);
  fill: none;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* ============================================================
   QUICK ACTIONS
   ============================================================ */
.qa-card{
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 24px;
}
.qa-head{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}
.qa-title{font-size: 14px; font-weight: 700; color: var(--text-1)}

.qa-grid{
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px;
}
.qa-btn{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 18px 8px;
  background: var(--subtle);
  border: 1px solid var(--border);
  border-radius: 10px;
  transition: all .15s ease;
  text-align: center;
}
.qa-btn:hover{
  background: var(--primary-soft);
  border-color: var(--primary-2);
  transform: translateY(-2px);
}
.qa-btn:hover .qa-icon{
  background: var(--primary-2);
  color: #fff;
}
.qa-icon{
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #fff;
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .15s ease;
  border: 1px solid var(--border);
}
.qa-icon svg{
  width: 18px;
  height: 18px;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.qa-label{
  font-size: 12px;
  font-weight: 600;
  color: var(--text-2);
  line-height: 1.3;
}

/* ============================================================
   ACTIVITY / EMPTY STATE
   ============================================================ */
.section-card{
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
}
.section-head{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}
.section-title{font-size: 14px; font-weight: 700; color: var(--text-1)}

.empty-activity{
  padding: 48px 20px;
  text-align: center;
  color: var(--text-3);
}
.empty-activity svg{
  width: 44px;
  height: 44px;
  stroke: var(--text-4);
  fill: none;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  margin-bottom: 14px;
}
.empty-activity h4{
  font-size: 15px;
  font-weight: 700;
  color: var(--text-2);
  margin-bottom: 6px;
}
.empty-activity p{
  font-size: 13px;
  color: var(--text-3);
  max-width: 360px;
  margin: 0 auto 18px;
  line-height: 1.5;
}

.btn-primary{
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  transition: all .15s ease;
}
.btn-primary:hover{
  background: var(--primary-2);
  box-shadow: 0 4px 12px rgba(37,99,235,0.28);
}
.btn-primary svg{
  width: 14px;
  height: 14px;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* ============================================================
   SIDEBAR BACKDROP (mobile)
   ============================================================ */
.sb-backdrop{
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(15,23,42,0.5);
  z-index: 98;
}
.sb-backdrop.show{display:block}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1100px){
  .kpi-grid{grid-template-columns: repeat(3, 1fr)}
  .chart-row{grid-template-columns: 1fr}
  .qa-grid{grid-template-columns: repeat(3, 1fr)}
}

@media (max-width: 900px){
  .app{grid-template-columns: 1fr}
  .sidebar{
    position: fixed;
    top: 0;
    left: -260px;
    width: 240px;
    z-index: 99;
    transition: left .25s ease;
    box-shadow: 0 12px 32px rgba(15,23,42,0.15);
  }
  .sidebar.open{left: 0}
  .tb-menu{display: block}
  .page{padding: 20px 16px 40px}
  .topbar{padding: 0 16px}
  .tb-date{display: none}
  .tb-name{max-width: 140px; font-size: 13px}
}

@media (max-width: 640px){
  .kpi-grid{grid-template-columns: 1fr}
  .qa-grid{grid-template-columns: repeat(2, 1fr)}
  .page-title{font-size: 20px}
  .kpi-value{font-size: 20px}
}
</style>
</head>
